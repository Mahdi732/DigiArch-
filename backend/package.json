    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "npm run lint"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.7",
    "@nestjs/config": "^3.1.1",
    "@nestjs/core": "^10.3.7",
    "@nestjs/mongoose": "^10.0.5",
    "@nestjs/platform-express": "^10.3.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "minio": "^8.0.1",
    "mongodb-memory-server": "^9.3.0",
    "mongoose": "^8.3.3",
    "multer": "^1.4.5-lts.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.7",
    "@types/node": "^20.11.30",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.2"
  }
