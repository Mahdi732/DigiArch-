{
  "name": "digiarch-backend",
  "version": "0.1.0",
  "description": "GED backend (NestJS, MongoDB, MinIO, LLM stub)",
  "main": "dist/main.js",
  "license": "MIT",
  "scripts": {
    "start": "node dist/main.js",
    "start:dev": "ts-node-dev --respawn --transpile-only src/main.ts",
